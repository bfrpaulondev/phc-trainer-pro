# ===== PHC Trainer Pro API =====
# Copie para .env e ajuste. NUNCA commite o .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas (free M0) ou instância local
MONGODB_URI=mongodb://127.0.0.1:27017/phc-trainer

# Segredos — em produção são OBRIGATÓRIOS (≥32 chars, aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# cifra as chaves de IA das equipas em repouso (AES-256-GCM)
ENCRYPTION_KEY=

# Origens permitidas (CORS), separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Tempo de vida dos tokens
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Chaves de IA globais (opcional — fallback quando a equipa não configura as suas)
AI_KEY_GROQ=
AI_KEY_GEMINI=
AI_KEY_MISTRAL=
AI_KEY_CEREBRAS=
AI_KEY_NVIDIA=
AI_KEY_OPENROUTER=
AI_MODEL_OPENROUTER=openai/gpt-4o-mini

# Observabilidade (opcional)
SENTRY_DSN=
